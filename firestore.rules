rules_version = '2';

// Reglas para el sitio de Kuta.
// Subilas con `firebase deploy --only firestore:rules` o pegalas en
// consola de Firebase → Firestore → Reglas.
//
// Criterio: el catálogo se lee sin autenticar (es un sitio público), pero
// NADIE escribe catálogo desde el navegador. Órdenes y leads sí se crean
// desde el cliente, con validación de forma, y no se pueden leer ni editar
// después: si cualquiera pudiera leer `orders`, tendría los datos personales
// de todos los compradores.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Catálogo: lectura pública, escritura sólo desde la consola ------
    match /products/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /merch/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /about/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // --- Órdenes y leads: sólo el servidor -------------------------------
    // Las crea /api/create-preference y /api/lead con el SDK de Admin, que
    // ignora estas reglas. Desde el navegador quedan cerradas del todo: no se
    // pueden crear (nadie inventa una orden pagada) ni leer (tienen datos
    // personales de terceros).
    match /orders/{doc} {
      allow read, write: if false;
    }

    match /leads/{doc} {
      allow read, write: if false;
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
