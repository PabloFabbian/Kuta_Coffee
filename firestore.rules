rules_version = '2';

// Reglas para el sitio de Kuta.
// Subilas con `firebase deploy --only firestore:rules` o pegalas en
// consola de Firebase → Firestore → Reglas.
//
// Criterio: el catálogo se lee sin autenticar (es un sitio público), pero
// NADIE escribe catálogo desde el navegador. Órdenes y leads sí se crean
// desde el cliente, con validación de forma, y no se pueden leer ni editar
// después: si cualquiera pudiera leer `orders`, tendría los datos personales
// de todos los compradores.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Catálogo: lectura pública, escritura sólo desde la consola ------
    match /products/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /merch/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /about/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // --- Órdenes: se crean, no se leen ni se modifican ------------------
    match /orders/{doc} {
      allow read, update, delete: if false;
      allow create: if
        request.resource.data.keys().hasAll(['comprador', 'items', 'total', 'estado'])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() < 50
        && request.resource.data.comprador.email is string
        && request.resource.data.comprador.email.matches('.+@.+\\..+');
    }

    // --- Leads mayoristas: mismo criterio -------------------------------
    match /mayorista/{doc} {
      allow read, update, delete: if false;
      allow create: if
        request.resource.data.keys().hasAll(['nombre', 'negocio', 'email'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 2
        && request.resource.data.nombre.size() < 120
        && request.resource.data.email.matches('.+@.+\\..+');
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
