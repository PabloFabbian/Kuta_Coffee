# ─────────────────────────────────────────────────────────────────────────────
# NAVEGADOR — Vite expone al bundle SOLO lo que empieza con VITE_.
# Son publicas por diseno: lo que protege la base son firestore.rules.
# ─────────────────────────────────────────────────────────────────────────────

VITE_apiKey=
VITE_authDomain=
VITE_projectId=
VITE_storageBucket=
VITE_messagingSenderId=
VITE_appId=
VITE_measurementId=

# ─────────────────────────────────────────────────────────────────────────────
# SERVIDOR — solo para las funciones de /api. Van SIN prefijo VITE_ para que
# Vite no las meta en el bundle. Se cargan en el panel de Vercel, no acá.
# ─────────────────────────────────────────────────────────────────────────────

# JSON de la service account de Firebase, en base64.
FIREBASE_SERVICE_ACCOUNT=

# Mercado Pago: access token de PRODUCCION de la cuenta de Kuta.
MP_ACCESS_TOKEN=

# Dominio final, para las URLs de retorno y el webhook.
SITE_URL=https://kuta.vercel.app

# Aviso de leads por mail.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=Kuta <onboarding@resend.dev>
